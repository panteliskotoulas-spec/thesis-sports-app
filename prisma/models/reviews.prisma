model FieldReview {
  id            String   @id @default(cuid())
  fieldId       String
  field         Field    @relation(fields: [fieldId], references: [id])
  reviewerId    String
  reviewer      User     @relation(fields: [reviewerId], references: [id])
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  @@index([fieldId, createdAt])
}

model CoachReview {
  id         String   @id @default(cuid())
  coachId    String
  coach      Coach           @relation(fields: [coachId], references: [id])
  reviewerId String
  reviewer   User            @relation(fields: [reviewerId], references: [id])
  sessionId  String          @unique
  session    CoachingSession @relation(fields: [sessionId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime        @default(now())

  @@index([coachId, createdAt])
}

model UserReview {
  id         String   @id @default(cuid())
  revieweeId String
  reviewee   User     @relation(fields: [revieweeId], references: [id], name: "ReviewsReceived")
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id], name: "ReviewsGiven")
  matchId    String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
}