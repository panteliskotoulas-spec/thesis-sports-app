model Field {
  id                String             @id @default(cuid())
  ownerId           String
  owner             User               @relation(fields: [ownerId], references: [id])
  name              Json
  description       Json
  area              Json
  sports            SportType[]        @default([])
  address           String
  latitude          Float
  longitude         Float
  indoor            Boolean
  status            FieldStatus        @default(PENDING)
  rejectionReason   Json?
  archivedAt        DateTime?
  images            FieldImage[]
  slots             AvailabilitySlot[]
  hostedTournaments Tournament[]
  reviews           FieldReview[]
  createdAt         DateTime           @default(now())
}

model FieldImage {
  id      String @id @default(cuid())
  fieldId String
  field   Field  @relation(fields: [fieldId], references: [id])
  url     String
  order   Int
}

model AvailabilitySlot {
  id            String       @id @default(cuid())
  fieldId       String
  field         Field        @relation(fields: [fieldId], references: [id])
  date          DateTime
  startTime     DateTime
  endTime       DateTime
  price         Decimal      @db.Decimal(10, 2)
  sportType     SportType
  status        SlotStatus   @default(OPEN)
  reservations  Reservation[]
  holdExpiresAt DateTime?
}