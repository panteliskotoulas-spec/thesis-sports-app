model Coach {
  id              String                  @id @default(cuid())
  userId          String                  @unique
  user            User                    @relation(fields: [userId], references: [id])
  sportType       SportType
  bio             Json
  area            Json                    @default("{}")
  hourlyRate      Decimal                 @db.Decimal(10, 2)
  certifications  String?
  status          CoachStatus             @default(PENDING)
  rejectionReason Json?
  createdAt       DateTime                @default(now())
  slots           CoachAvailabilitySlot[]
  reviews         CoachReview[]
}

model CoachAvailabilitySlot {
  id        String           @id @default(cuid())
  coachId   String
  coach     Coach            @relation(fields: [coachId], references: [id])
  date      DateTime
  startTime DateTime
  endTime   DateTime
  price     Decimal          @db.Decimal(10, 2)
  status    CoachSlotStatus  @default(OPEN)
  sessions  CoachingSession[]
}

model CoachingSession {
  id               String                @id @default(cuid())
  slotId           String
  slot             CoachAvailabilitySlot @relation(fields: [slotId], references: [id])
  userId           String
  user             User                  @relation(fields: [userId], references: [id])
  teamId           String?
  team             Team?                 @relation(fields: [teamId], references: [id])
  status           SessionStatus         @default(PENDING)
  price            Decimal               @default(0) @db.Decimal(10, 2)
  createdAt        DateTime              @default(now())
  respondedAt      DateTime?
  payBy            DateTime?
  paidAt           DateTime?
  cancelledAt      DateTime?
  compensationType CompensationType?

  @@index([slotId])
  @@index([userId])
  @@index([status])
}