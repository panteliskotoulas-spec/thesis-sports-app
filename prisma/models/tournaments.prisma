model Tournament {
  id           String                  @id @default(cuid())
  name         String
  sportType    SportType
  hostFieldId  String
  hostField    Field                   @relation(fields: [hostFieldId], references: [id])
  organizerId  String
  organizer    User                    @relation(fields: [organizerId], references: [id])
  startDate    DateTime
  endDate      DateTime
  maxTeams     Int                     @default(8)
  description  Json
  status       TournamentStatus        @default(UPCOMING)
  createdAt    DateTime                @default(now())
  teams        TournamentTeam[]
  teamRequests TournamentTeamRequest[]
  matches      Match[]

  @@index([sportType, status])
}

model TournamentTeam {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id])

  @@unique([tournamentId, teamId])
}

model TournamentTeamRequest {
  id           String                  @id @default(cuid())
  tournamentId String
  tournament   Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status       TournamentRequestStatus @default(PENDING)
  createdAt    DateTime                @default(now())

  @@unique([tournamentId, teamId])
  @@index([tournamentId, status])
}

model Match {
  id           String            @id @default(cuid())
  tournamentId String
  tournament   Tournament        @relation(fields: [tournamentId], references: [id])
  round        Int
  homeTeamId   String
  homeTeam     Team              @relation("MatchHome", fields: [homeTeamId], references: [id])
  awayTeamId   String
  awayTeam     Team              @relation("MatchAway", fields: [awayTeamId], references: [id])
  scheduledAt  DateTime?
  homeScore    Int?
  awayScore    Int?
  sets         Json?
  status       MatchStatus       @default(SCHEDULED)
  playerStats  MatchPlayerStat[]

  @@index([tournamentId, round])
}

model MatchPlayerStat {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId  String
  team    Team   @relation(fields: [teamId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  stats   Json

  @@unique([matchId, userId])
  @@index([userId])
  @@index([teamId])
}